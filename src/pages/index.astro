---
import { Image } from 'astro:assets';
import ClinicHero from '../assets/clinic-hero-room.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 640px;
			}
			.hero h1 {
				font-size: 2.4rem;
				line-height: 1.45;
				letter-spacing: 0;
				text-wrap: balance;
				margin-bottom: 1.2rem;
			}
			.hero p {
				margin-bottom: 1.5em;
			}
			.hero p:last-child {
				margin-bottom: 0;
			}
			.hero-visual {
				margin-bottom: 2.5rem;
			}
			.hero-visual img {
				display: block;
				width: 100%;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.island-card {
				display: grid;
				grid-template-columns: 1fr;
				margin: 2.5rem 0 0;
				border: 1px solid #e4dacb;
				border-radius: 16px;
				overflow: hidden;
				background: #fbf8f3;
				box-shadow: var(--box-shadow);
				text-decoration: none;
				color: inherit;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.island-card:hover {
				transform: translateY(-2px);
			}
			.island-card img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 1200 / 630;
			}
			.island-card .ic-body {
				padding: 1.2rem 1.4rem 1.4rem;
			}
			.island-card .ic-eye {
				margin: 0 0 0.3rem;
				font-size: 0.8rem;
				letter-spacing: 0.2em;
				color: #b08d57;
				font-weight: 700;
			}
			.island-card h2 {
				margin: 0 0 0.5rem;
				font-size: 1.4rem;
				line-height: 1.4;
				color: #0e335f;
			}
			.island-card .ic-text {
				margin: 0 0 1rem;
				font-size: 0.98rem;
				line-height: 1.75;
			}
			.island-card .ic-cta {
				display: inline-block;
				padding: 0.55rem 1.3rem;
				border-radius: 999px;
				background: #0e335f;
				color: #fbf8f3;
				font-weight: 700;
				font-size: 0.95rem;
				letter-spacing: 0.06em;
			}
			@media (max-width: 720px) {
				.hero h1 {
					font-size: 1.75rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<div class="hero-visual">
					<Image
						src={ClinicHero}
						width={1672}
						height={941}
						alt="無痕美學診所的療程空間"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<h1>減法思維，做有溫度的醫美</h1>
				<p>
					無痕美學診所位於台北大安區，以「減法思維」為核心，分享醫美衛教與真實診所日常。
				</p>
				<p>
					我們相信美麗來自健康與自然。無痕美學診所提供專業的醫美諮詢與療程，並透過這個部落格分享實用的醫美衛教知識，幫助你做出更安心的選擇。
				</p>
			</div>
			<a class="island-card" href="/island/">
				<img src="/island/og.jpg" width="1200" height="630" alt="無痕美學島：做成一座會動小島的無痕美學診所" loading="lazy" />
				<div class="ic-body">
					<p class="ic-eye">無痕美學島　開島了</p>
					<h2>我們把診所做成一座會動的小島</h2>
					<p class="ic-text">八個空間點進去看衛教，玩防曬小遊戲、摸貓咖的貓店員，逛完全島抽一支院長保養籤，拿一張專屬島民證桌布。</p>
					<span class="ic-cta">開始逛島 →</span>
				</div>
			</a>
		</main>
		<Footer />
	</body>
</html>
